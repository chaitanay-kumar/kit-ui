{
  "name": "kit-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "brand:generate": "node scripts/generate-brand-assets.mjs",
    "dev": "vite",
    "build": "npm run angular:build && npm run component:sync && tsc -b && vite build && npm run prerender && npm run seo:audit",
    "prerender": "node --import ./scripts/register-assets.mjs --import tsx scripts/prerender.ts",
    "registry:generate": "tsx scripts/generate-registry.ts",
    "registry:validate": "tsx scripts/validate-registry.ts",
    "component:sync": "tsx scripts/generate-registry.ts && tsx scripts/validate-registry.ts",
    "component:new": "tsx scripts/component-new.ts",
    "seo:sitemap": "tsx scripts/generate-sitemap.ts",
    "seo:llms": "tsx scripts/generate-llms.ts",
    "seo:audit": "tsx scripts/seo-audit.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "lint": "oxlint",
    "preview": "vite preview",
    "angular:sync": "tsx scripts/generate-angular-ports.ts",
    "angular:build": "npm run angular:sync && node scripts/build-angular.mjs",
    "test:angular-package": "node scripts/verify-angular-package.mjs",
    "test:ios-search": "node scripts/verify-ios-search.mjs",
    "test:parity-batch4": "node scripts/verify-parity-batch4.mjs",
    "test:activity-feed": "node scripts/verify-activity-feed.mjs",
    "predev": "npm run angular:build",
    "test:data-table": "node scripts/verify-data-table.mjs",
    "test:agent-activity": "node scripts/verify-agent-activity.mjs",
    "test:prompt-composer": "node scripts/verify-prompt-composer.mjs",
    "test:loader": "node scripts/verify-loader.mjs",
    "test:button": "node scripts/verify-button.mjs",
    "test:neon-edge-button": "node scripts/verify-neon-edge-button.mjs",
    "test:orbital-loading-ring": "node scripts/verify-orbital-loading-ring.mjs",
    "test:spotlight-card": "node scripts/verify-spotlight-card.mjs",
    "test:morphing-icon": "node scripts/verify-morphing-icon.mjs",
    "test:rainbow-button": "node scripts/verify-rainbow-button.mjs",
    "test:magnetic-button": "node scripts/verify-magnetic-button.mjs",
    "test:press-button": "node scripts/verify-press-button.mjs",
    "test:morphing-button": "node scripts/verify-morphing-button.mjs",
    "test:typewriter-button": "node scripts/verify-typewriter-button.mjs",
    "test:hamburger-menu": "node scripts/verify-hamburger-menu.mjs",
    "test:expandable-search": "node scripts/verify-expandable-search.mjs",
    "test:smooth-accordion": "node scripts/verify-smooth-accordion.mjs",
    "test:stretch-switch": "node scripts/verify-stretch-switch.mjs",
    "test:reveal-card": "node scripts/verify-reveal-card.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/roboto": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "framer-motion": "^13.1.0",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.21.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@angular/common": "20.3.33",
    "@angular/compiler": "20.3.33",
    "@angular/compiler-cli": "20.3.33",
    "@angular/core": "20.3.33",
    "@angular/platform-browser": "20.3.33",
    "@playwright/test": "1.64.0",
    "@tailwindcss/node": "4.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.5.4",
    "jsdom": "^29.1.1",
    "ng-packagr": "20.3.2",
    "oxlint": "^1.75.0",
    "postcss": "^8.5.26",
    "rxjs": "7.8.2",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tslib": "2.8.1",
    "tsx": "^4.23.12",
    "typescript": "5.9.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.11"
  },
  "description": "Independent, tactile React and Angular components. Copy the source and make it yours.",
  "repository": {
    "type": "git",
    "url": "https://github.com/chaitanay-kumar/kit-ui.git"
  },
  "license": "MIT",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  }
}
